# URL del backend de TurisClick.
#
# Si no se define, la app deduce un default de desarrollo (ver src/lib/env.ts). Definila explícitamente
# cuando el backend no esté en el puerto 5288 o cuando apuntes a un entorno remoto.
#
# Elegí la que corresponda al lugar donde CORRE LA APP, no donde corre el backend:
#
#   iOS Simulator        EXPO_PUBLIC_API_BASE_URL=http://localhost:5288
#   Android Emulator     EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5288
#   Dispositivo físico   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.X:5288   (IP de LAN de tu PC)
#
# Nota: EXPO_PUBLIC_* queda embebido en el bundle. No pongas secretos acá.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5288
