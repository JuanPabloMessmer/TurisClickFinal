            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "UC-AUTH-01. Excepción: DataAnnotations rechaza email/nombre/password inválidos antes de llegar al Service."
          }
        },
        {
          "name": "UC-AUTH-02 - Login - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test(\"Token exists\", function () {",
                  "    pm.expect(jsonData.accessToken).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Role is TOURIST\", function () {",
                  "    pm.expect(jsonData.user.role).to.eql(\"TOURIST\");",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"access_token\", jsonData.accessToken);",
                  "pm.collectionVariables.set(\"refresh_token\", jsonData.refreshToken);",
                  "pm.collectionVariables.set(\"tourist_token\", jsonData.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{tourist_email}}\",\n  \"password\": \"{{tourist_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "UC-AUTH-02. Flujo exitoso con el usuario creado en UC-AUTH-01."
          }
        },
