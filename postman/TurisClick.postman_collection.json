  "item": [
    {
      "name": "Authentication",
      "description": "UC-AUTH-01..04 — Oleada 0.",
      "item": [
        {
          "name": "UC-AUTH-01 - Register Tourist - Success",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const uniqueEmail = `tourist.${Date.now()}.${Math.floor(Math.random() * 100000)}@turisclick.dev`;",
                  "pm.collectionVariables.set(\"tourist_email\", uniqueEmail);",
                  "pm.collectionVariables.set(\"tourist_password\", \"Password123!\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test(\"Response has accessToken and refreshToken\", function () {",
                  "    pm.expect(jsonData.accessToken).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(jsonData.refreshToken).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Role is TOURIST\", function () {",
                  "    pm.expect(jsonData.user.role).to.eql(\"TOURIST\");",
                  "});",
                  "",
                  "pm.test(\"Email matches the one sent\", function () {",
                  "    pm.expect(jsonData.user.email).to.eql(pm.collectionVariables.get(\"tourist_email\"));",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"user_id\", jsonData.user.id);",
                  "pm.collectionVariables.set(\"access_token\", jsonData.accessToken);",
                  "pm.collectionVariables.set(\"refresh_token\", jsonData.refreshToken);",
                  "pm.collectionVariables.set(\"tourist_token\", jsonData.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Turista de Prueba\",\n  \"email\": \"{{tourist_email}}\",\n  \"password\": \"{{tourist_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "UC-AUTH-01. Flujo exitoso: crea un TOURIST y devuelve tokens (auto-login)."
          }
        },
        {
          "name": "UC-AUTH-01 - Register Tourist - Duplicate Email (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 409\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test(\"Problem details reports Conflict\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(409);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Turista de Prueba\",\n  \"email\": \"{{tourist_email}}\",\n  \"password\": \"{{tourist_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "UC-AUTH-01. Excepción: el email ya existe (Regla de negocio: email único)."
          }
        },
