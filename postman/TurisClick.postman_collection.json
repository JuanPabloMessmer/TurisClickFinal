{
  "info": {
    "_postman_id": "a3f1e7b0-6c2d-4b8a-9e5a-turisclick0001",
    "name": "TurisClick API",
    "description": "Colección organizada por caso de uso (docs/use-cases.md). Cada carpeta agrupa los UC de una oleada. Actualmente: Oleada 0 (Authentication).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
