        {
          "name": "UC-AUTH-03 - Refresh Token - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test(\"New access token returned\", function () {",
                  "    pm.expect(jsonData.accessToken).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Refresh token was rotated\", function () {",
                  "    pm.expect(jsonData.refreshToken).to.not.eql(pm.collectionVariables.get(\"refresh_token\"));",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"access_token\", jsonData.accessToken);",
                  "pm.collectionVariables.set(\"refresh_token\", jsonData.refreshToken);",
                  "pm.collectionVariables.set(\"tourist_token\", jsonData.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "refresh"]
            },
            "description": "UC-AUTH-03. Flujo exitoso: rota el refresh token (el usado queda revocado)."
          }
        },
        {
          "name": "UC-AUTH-03 - Refresh Token - Invalid Token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
